<mujoco model="scene_obstacles">
  <!-- Balance challenge: low steps, a ramp and scattered blocks. -->
  <include file="robot.xml"/>

  <statistic center="1 0 0.6" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.05 0.08 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
             rgb1="0.78 0.79 0.81" rgb2="0.70 0.72 0.75"
             markrgb="0.6 0.62 0.66" mark="edge" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="6 6" reflectance="0.15"/>
    <material name="concrete" rgba="0.6 0.6 0.62 1"/>
    <material name="wood" rgba="0.55 0.38 0.22 1"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="25 25 0.01" material="groundplane"
          contype="1" conaffinity="1" friction="1.0 0.1 0.01"/>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           castshadow="true"/>
    <light pos="-2 2 3" dir="0.5 -0.5 -1" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>

    <geom name="step_1" type="box" size="0.4 0.8 0.015" pos="1.2 0 0.015" material="concrete"/>
    <geom name="step_2" type="box" size="0.25 0.8 0.03" pos="1.35 0 0.03" material="concrete"/>
    <geom name="ramp" type="box" size="0.5 0.7 0.02" pos="2.6 0 0.09" euler="0 -0.12 0" material="concrete"/>
    <geom name="beam" type="box" size="0.6 0.12 0.02" pos="0 1.5 0.02" material="wood"/>

    <body name="crate_1" pos="0.8 -1 0.1">
      <freejoint/>
      <geom type="box" size="0.1 0.1 0.1" material="wood" mass="2"/>
    </body>
    <body name="ball_1" pos="-1 0.8 0.12">
      <freejoint/>
      <geom type="sphere" size="0.12" rgba="0.9 0.55 0.15 1" mass="1"/>
    </body>
  </worldbody>
</mujoco>
