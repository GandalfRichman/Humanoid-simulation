<mujoco model="scene_table">
  <!-- Manipulation practice: a table with a red cylinder in reach of the robot
       (adapted from the luckyrobots g1-manipulation-challenge scene). -->
  <include file="robot.xml"/>

  <statistic center="0.2 0 0.6" extent="2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.05 0.08 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
             rgb1="0.78 0.79 0.81" rgb2="0.70 0.72 0.75"
             markrgb="0.6 0.62 0.66" mark="edge" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="6 6" reflectance="0.15"/>
    <material name="table_wood" rgba="0.55 0.35 0.2 1" specular="0.3" shininess="0.5"/>
    <material name="red_plastic" rgba="0.85 0.1 0.1 1" specular="0.5" shininess="0.8"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="25 25 0.01" material="groundplane"
          contype="1" conaffinity="1" friction="1.0 0.1 0.01"/>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           castshadow="true"/>
    <light pos="-2 2 3" dir="0.5 -0.5 -1" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>

    <body name="table" pos="0.95 0 0.713">
      <geom name="table_top" type="box" size="0.4 0.25 0.02" material="table_wood"
            friction="1 0.1 0.01" mass="10"/>
      <geom name="table_leg_1" type="cylinder" size="0.025 0.345" pos="0.35 0.2 -0.365"
            rgba="0.4 0.25 0.15 1" mass="1"/>
      <geom name="table_leg_2" type="cylinder" size="0.025 0.345" pos="-0.35 0.2 -0.365"
            rgba="0.4 0.25 0.15 1" mass="1"/>
      <geom name="table_leg_3" type="cylinder" size="0.025 0.345" pos="0.35 -0.2 -0.365"
            rgba="0.4 0.25 0.15 1" mass="1"/>
      <geom name="table_leg_4" type="cylinder" size="0.025 0.345" pos="-0.35 -0.2 -0.365"
            rgba="0.4 0.25 0.15 1" mass="1"/>
    </body>

    <body name="red_block" pos="0.7 0.026 0.85">
      <freejoint name="red_block_joint"/>
      <geom name="red_cylinder" type="cylinder" size="0.02 0.035"
            material="red_plastic" density="100" friction="3 0.1 0.01"/>
      <geom name="red_cap_top" type="box" size="0.018 0.018 0.002" pos="0 0 0.035"
            rgba="0.85 0.1 0.1 1" density="10" friction="3 0.1 0.01"/>
      <geom name="red_cap_bot" type="box" size="0.018 0.018 0.002" pos="0 0 -0.035"
            rgba="0.85 0.1 0.1 1" density="10" friction="3 0.1 0.01"/>
    </body>
  </worldbody>
</mujoco>
