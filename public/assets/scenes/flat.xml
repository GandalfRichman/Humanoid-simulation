<mujoco model="scene_flat">
  <include file="robot.xml"/>

  <statistic center="0 0 0.8" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.05 0.08 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
             rgb1="0.78 0.79 0.81" rgb2="0.70 0.72 0.75"
             markrgb="0.6 0.62 0.66" mark="edge"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="6 6" reflectance="0.15"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="25 25 0.01" material="groundplane"
          contype="1" conaffinity="1" friction="1.0 0.1 0.01"/>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           castshadow="true"/>
    <light pos="-2 2 3" dir="0.5 -0.5 -1" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
  </worldbody>
</mujoco>
